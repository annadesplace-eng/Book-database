# Copy to .env and fill in your own values. Never commit .env.
# Find the keys in Supabase: Project Settings -> API Keys.

# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Publishable key: safe to use in the browser.
# The web page reads its copy from the SETTINGS block in index.html.
SUPABASE_PUBLISHABLE_KEY=

# Shared secret for the scrape-books function. Choose a long random value,
# save the same value in Supabase (Edge Functions -> Secrets) as SCRAPER_SECRET.
SCRAPER_SECRET=

# Service role / secret key: SERVER ONLY. Never put this in the HTML or commit it.
# Supabase injects it into Edge Functions automatically; you only need it here
# if you run the scrape-books function locally with `supabase functions serve`.
SUPABASE_SERVICE_ROLE_KEY=
